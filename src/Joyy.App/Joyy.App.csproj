<Project Sdk="Microsoft.NET.Sdk">

  <!-- The user-facing tray app. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF's imaging (WIC) decodes WebP/JPEG/PNG controller photos; no WPF windows are used. -->
    <UseWPF>true</UseWPF>
    <RootNamespace>Joyy.App</RootNamespace>
    <AssemblyName>Joyy</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>

    <!-- What Windows shows for the exe, the Start menu entry and Apps &amp; features. -->
    <ApplicationIcon>Assets\joyy.ico</ApplicationIcon>
    <Product>Joyy</Product>
    <AssemblyTitle>Joyy</AssemblyTitle>
    <Description>Use a PS5 DualSense as an Xbox 360 controller</Description>
    <Company>Joyy</Company>
    <Copyright>Joyy</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <!-- Release package (tools\publish.ps1): one self-contained Joyy.exe that offers to install itself. -->
  <PropertyGroup Condition="'$(JoyyPublished)' == 'true'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DefineConstants>$(DefineConstants);PUBLISHED</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF drops System.IO from implicit usings (WPF has its own Path type); we only use WPF imaging. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- HidHide's installer rides inside Joyy.exe so nobody downloads it separately (tools\fetch-deps.ps1 puts it in deps\). -->
    <EmbeddedResource Include="..\..\deps\HidHide_1.5.230_x64.exe" LogicalName="HidHideSetup.exe" Condition="Exists('..\..\deps\HidHide_1.5.230_x64.exe')" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="ThirdPartyNotices.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Joyy.Platform\Joyy.Platform.csproj" />
  </ItemGroup>

</Project>
